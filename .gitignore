# BMad / Claude tooling (local only)
_bmad/
.claude/

# Nix — build outputs + direnv cache. NOTE: flake.lock IS committed (it's the version pin).
result
result-*
.direnv/

# Dependencies
node_modules/
.pnp/
.pnp.*

# Bun
bun.lockb
.bun/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# K8s Secret manifests hold real creds — commit secret.example.yaml only.
# Real secrets are applied locally now; Sealed Secrets in the GitOps phase.
# Component-foldered layout: deploy/k8s/<group>/<component>/secret.yaml
deploy/k8s/**/secret.yaml
!deploy/k8s/**/secret.example.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log

# Kubernetes / Helm
*.kubeconfig
charts/*.tgz

# ECR auth ConfigMap embeds the account-id registry host — keep out of git (commit the .example)
deploy/k8s/platform/ecr-auth/configmap.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ADR-020: Sealed Secrets private sealing key backup — NEVER commit (master key)
*sealed-secrets-key*.yaml
sealed-secrets-key.backup.yaml
